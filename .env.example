# Optional settings. Environment variables override routing values in config/gateways.json.
ROUTEWISE_DATABASE_PATH=data/routewise.db
ROUTEWISE_GATEWAY_CONFIG=config/gateways.json
ROUTEWISE_DEFAULT_CURRENCY=INR
ROUTEWISE_SUCCESS_WEIGHT=0.70
ROUTEWISE_LATENCY_WEIGHT=0.20
ROUTEWISE_COST_WEIGHT=0.10
ROUTEWISE_LATENCY_REFERENCE_MS=500
ROUTEWISE_COST_REFERENCE_UNITS=0.05
ROUTEWISE_HOST=127.0.0.1
ROUTEWISE_PORT=8000
